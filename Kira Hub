-- [[ KIRA PRO 🩸 - CLEAN UI EDITION ]] --
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer

-- KEYS (1 a 50)
local validKeys = {}
for i = 1, 50 do validKeys["keytogether" .. i] = true end

local function StartHub()
    local MainGui = Instance.new("ScreenGui", CoreGui)
    MainGui.Name = "KiraPro_Clean"

    _G.Config = { 
        Magnet = false, 
        Range = 30, 
        InfJump = false, 
        Speed = 16 
    }
    local SavedPos = nil

    -- ANTI-AFK
    local VU = game:GetService("VirtualUser")
    LP.Idled:Connect(function() VU:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame); task.wait(1); VU:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame) end)

    -- BOTÃO ABRIR (LIMPO)
    local OpenBtn = Instance.new("TextButton", MainGui)
    OpenBtn.Size = UDim2.new(0, 60, 0, 60)
    OpenBtn.Position = UDim2.new(0.05, 0, 0.1, 0)
    OpenBtn.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
    OpenBtn.Text = "KIRA"
    OpenBtn.TextColor3 = Color3.new(1, 1, 1) -- Branco puro
    OpenBtn.Font = Enum.Font.GothamBold
    OpenBtn.TextSize = 14
    OpenBtn.Draggable = true; OpenBtn.Active = true
    Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1,0)

    -- BOTÕES EXTERNOS (MAIORES E SEM SOMBRA)
    local function CreateExtBtn(txt, pos, bgClr)
        local b = Instance.new("TextButton", MainGui)
        b.Size = UDim2.new(0, 160, 0, 55)
        b.Position = pos
        b.BackgroundColor3 = bgClr
        b.Text = txt
        b.TextColor3 = Color3.new(1, 1, 1) -- Letras brancas para leitura fácil
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.Draggable, b.Active = true, true
        Instance.new("UICorner", b)
        return b
    end

    local MarkBtn = CreateExtBtn("SALVAR POSIÇÃO", UDim2.new(0.05, 0, 0.25, 0), Color3.fromRGB(0, 0, 0))
    local FlyBtn = CreateExtBtn("VOAR ATÉ MARCA", UDim2.new(0.05, 0, 0.35, 0), Color3.fromRGB(150, 0, 0))

    -- MENU PRINCIPAL (DESIGN PRETO SÓLIDO)
    local Main = Instance.new("Frame", MainGui)
    Main.Size = UDim2.new(0, 260, 0, 420)
    Main.Position = UDim2.new(0.5, -130, 0.5, -210)
    Main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Main.Visible = false; Main.Draggable, Main.Active = true, true
    Instance.new("UICorner", Main)

    -- TÍTULO
    local Tt = Instance.new("TextLabel", Main)
    Tt.Size = UDim2.new(1, 0, 0, 50)
    Tt.Text = "KIRA PRO 🩸"; Tt.TextColor3 = Color3.new(1,1,1)
    Tt.Font = Enum.Font.GothamBlack; Tt.TextSize = 18; Tt.BackgroundTransparency = 1

    -- FUNÇÃO VOO
    local function DoFly()
        if SavedPos and LP.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LP.Character.HumanoidRootPart
            local dist = (hrp.Position - SavedPos.Position).Magnitude
            TweenService:Create(hrp, TweenInfo.new(dist/350, Enum.EasingStyle.Linear), {CFrame = SavedPos}):Play()
        end
    end

    MarkBtn.MouseButton1Click:Connect(function()
        if LP.Character:FindFirstChild("HumanoidRootPart") then
            SavedPos = LP.Character.HumanoidRootPart.CFrame
            MarkBtn.Text = "POSIÇÃO SALVA!"
            task.wait(1); MarkBtn.Text = "SALVAR POSIÇÃO"
        end
    end)
    FlyBtn.MouseButton1Click:Connect(DoFly)

    -- BOTÕES INTERNOS (ESTILO LISTA)
    local function AddBtn(txt, pos, f)
        local b = Instance.new("TextButton", Main)
        b.Size = UDim2.new(0.9, 0, 0, 45); b.Position = pos
        b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        b.Text = txt; b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamMedium; b.TextSize = 14
        Instance.new("UICorner", b)
        b.MouseButton1Click:Connect(function() f(b) end)
    end

    AddBtn("PULO INFINITO: OFF", UDim2.new(0.05, 0, 0.18, 0), function(s)
        _G.Config.InfJump = not _G.Config.InfJump
        s.Text = "PULO INFINITO: " .. (_G.Config.InfJump and "ON" or "OFF")
        s.BackgroundColor3 = _G.Config.InfJump and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(40, 40, 40)
    end)

    local SpeedInput = Instance.new("TextBox", Main)
    SpeedInput.Size = UDim2.new(0.9, 0, 0, 45); SpeedInput.Position = UDim2.new(0.05, 0, 0.32, 0)
    SpeedInput.PlaceholderText = "Digite a Velocidade"; SpeedInput.Text = "50"
    SpeedInput.BackgroundColor3 = Color3.fromRGB(25, 25, 25); SpeedInput.TextColor3 = Color3.new(1, 1, 1)
    SpeedInput.Font = Enum.Font.Gotham; SpeedInput.TextSize = 14
    Instance.new("UICorner", SpeedInput)
    
    AddBtn("APLICAR VELOCIDADE", UDim2.new(0.05, 0, 0.45, 0), function()
        _G.Config.Speed = tonumber(SpeedInput.Text) or 16
    end)

    AddBtn("MAGNET (COLETAR): OFF", UDim2.new(0.05, 0, 0.60, 0), function(s)
        _G.Config.Magnet = not _G.Config.Magnet
        s.Text = "MAGNET: " .. (_G.Config.Magnet and "ON" or "OFF")
        s.BackgroundColor3 = _G.Config.Magnet and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(40, 40, 40)
    end)

    AddBtn("FLY GUI V3", UDim2.new(0.05, 0, 0.80, 0), function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt"))()
    end)

    OpenBtn.MouseButton1Click:Connect(function() Main.Visible = not Main.Visible end)

    -- LOGICA DE MOVIMENTO
    RunService.Stepped:Connect(function()
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            LP.Character.Humanoid.WalkSpeed = _G.Config.Speed
        end
    end)

    UIS.JumpRequest:Connect(function()
        if _G.Config.InfJump and LP.Character:FindFirstChildOfClass("Humanoid") then
            LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        end
    end)

    RunService.Heartbeat:Connect(function()
        if _G.Config.Magnet and LP.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LP.Character.HumanoidRootPart
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("TouchTransmitter") and v.Parent and v.Parent:IsA("BasePart") then
                    if (hrp.Position - v.Parent.Position).Magnitude <= _G.Config.Range then
                        firetouchinterest(hrp, v.Parent, 0); firetouchinterest(hrp, v.Parent, 1)
                    end
                end
            end
        end
    end)
end

-- LOGIN SIMPLES
local KeyGui = Instance.new("ScreenGui", CoreGui)
local KF = Instance.new("Frame", KeyGui)
KF.Size = UDim2.new(0, 300, 0, 180); KF.Position = UDim2.new(0.5, -150, 0.5, -90)
KF.BackgroundColor3 = Color3.new(0,0,0)
local TI = Instance.new("TextBox", KF)
TI.Size = UDim2.new(0.8, 0, 0, 40); TI.Position = UDim2.new(0.1, 0, 0.3, 0); TI.PlaceholderText = "Digite sua Key..."
local B = Instance.new("TextButton", KF)
B.Size = UDim2.new(0.6, 0, 0, 40); B.Position = UDim2.new(0.2, 0, 0.7, 0); B.Text = "ENTRAR"
B.MouseButton1Click:Connect(function()
    if validKeys[TI.Text] then KeyGui:Destroy(); StartHub() else B.Text = "KEY INCORRETA" end
end)
